# Copy to .env or export these in your shell before running E3SM-dependent tools.

# Directory containing E3SM SCM case directories.
export SCM_RUNS="/path/to/SCM_runs"

# E3SM source checkout used by generated case scripts.
export E3SM_CODE_DIR="/path/to/E3SM"

# ARM97 IOP forcing/observation file.
export ARM97_IOP_FILE="/path/to/ARM97_iopfile_4scam.nc"

# Optional pre-built baseline executable for reuse-build workflows.
# TEMPLATE_EXE is the generic override used by generated scripts.
export TEMPLATE_EXE="/path/to/platform-compatible/baseline/build/e3sm.exe"

# Platform-specific convenience variables. The Mac executable must be a macOS
# binary; the NERSC executable must be built on NERSC or a compatible Linux
# environment.
export TEMPLATE_EXE_MAC="/Users/yunlong/Workshop/SCM-UQ-Workflow/e3sm_scm_run_scripts_baseline/baseline-output/scm_ARM97_baseline/build/e3sm.exe"
export TEMPLATE_EXE_NERSC="/pscratch/sd/y/yunlong/SCM_runs/nersc_ARM97_reusable_baseline/build/e3sm.exe"

# Optional extra binaries/libraries path for local compiler/runtime tools.
export SCM_UQ_EXTRA_PATH="/path/to/bin:/usr/bin:/bin:/usr/sbin:/sbin"
