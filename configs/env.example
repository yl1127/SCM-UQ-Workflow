# Copy this file to `.env` at the repository root and edit paths for your machine.

export SCM_RUNS="/path/to/SCM_runs"
export E3SM_CODE_DIR="/path/to/E3SM"

# ARM97 forcing/observation and baseline files used by comparison tools.
export ARM97_IOP_FILE="/path/to/arm97_iop.nc"

export SCM_BASELINE_HISTORY_FILE="/path/to/baseline.eam.h0.nc"

# Optional reusable E3SM executables for reuse-build workflows.
export TEMPLATE_EXE=""
export TEMPLATE_EXE_MAC=""
export TEMPLATE_EXE_NERSC=""

# Optional compiler/runtime path additions for case setup and execution.
export SCM_UQ_EXTRA_PATH=""
